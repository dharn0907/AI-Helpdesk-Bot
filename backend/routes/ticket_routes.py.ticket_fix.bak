Base.metadata.create_all(bind=engine)


def get_active_chatbot(db, chatbot_id):
    """Validate chatbot and its owning organization."""

    chatbot = (
        db.query(Chatbot)
        .filter(
            Chatbot.id == chatbot_id,
            Chatbot.status == "active",
        )
        .first()
    )

    if not chatbot:
        raise HTTPException(
            status_code=404,
            detail="Chatbot not found or inactive.",
        )

    company = (
        db.query(Company)
        .filter(
            Company.id == chatbot.organization_id,
            Company.is_active.is_(True),
        )
        .first()
    )

    if not company:
        raise HTTPException(
            status_code=404,
            detail="Organization not found or inactive.",
        )

    return chatbot, company


def get_scoped_ticket(db, ticket_id, chatbot_id):
    """Retrieve a ticket belonging only to the specified chatbot."""

    return (
        db.query(Ticket)
        .filter(
            Ticket.ticket_id == ticket_id,
            Ticket.chatbot_id == chatbot_id,
        )
        .first()
    )


@router.post("/")
def create_ticket(data: dict, db: Session = Depends(get_db)):

    customer_message = str(
        data.get("customer_message", "")
    ).strip()

    intent = data.get("intent", "general_enquiry")
    session_id = data.get("session_id")
    additional_details = data.get("additional_details", "")
    customer_email = data.get("customer_email")
    chatbot_id = data.get("chatbot_id")

    if not customer_message:
        raise HTTPException(
            status_code=400,
            detail="Customer complaint cannot be empty.",
        )

    if not chatbot_id:
        raise HTTPException(
            status_code=400,
            detail="Chatbot ID is required.",
        )

    chatbot, company = get_active_chatbot(db, chatbot_id)

    ticket = Ticket(
        ticket_id=f"TKT-{uuid.uuid4().hex[:8].upper()}",
        session_id=session_id,
        company_id=company.id,
        chatbot_id=chatbot.id,
        customer_message=customer_message,
        additional_details=additional_details,
        customer_email=customer_email,
        intent=intent,
        priority="Medium",
        status="Open",
    )

    db.add(ticket)
    db.commit()
    db.refresh(ticket)

    return {
        "message": "Ticket created successfully.",
        "ticket_id": ticket.ticket_id,
        "status": ticket.status,
        "chatbot_id": ticket.chatbot_id,
    }


@router.get("/")
def get_all_tickets(
    chatbot_id: int,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias="X-Company-ID")
):

    company = get_workspace_company(authorization, x_company_id, db)
    chatbot, _ = get_active_chatbot(db, chatbot_id)
    if chatbot.organization_id != company['id']:
        raise HTTPException(403, 'Chatbot does not belong to this company.')

    tickets = (
        db.query(Ticket)
        .filter(
            Ticket.chatbot_id == chatbot_id,
            Ticket.company_id == company["id"],
        )
        .order_by(Ticket.created_at.desc())
        .all()
    )

    result = []
    for ticket in tickets:
        item = {
            column.name: getattr(ticket, column.name)
            for column in Ticket.__table__.columns
        }

        assignment = (
            db.query(TicketAssignment, OrganizationMember)
            .outerjoin(
                OrganizationMember,
                TicketAssignment.assigned_member_id == OrganizationMember.id
            )
            .filter(
                TicketAssignment.ticket_id == ticket.id,
                TicketAssignment.organization_id == company["id"],
            )
            .order_by(TicketAssignment.assigned_at.desc())
            .first()
        )

        member = assignment[1] if assignment else None
        item["assigned_agent"] = (
            {
                "id": member.id,
                "name": member.full_name,
                "email": member.email,
            }
            if member else None
        )
        result.append(item)

    return result



@router.post("/agents")
def create_support_agent(
    data: dict,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias="X-Company-ID"),
):
    company = get_workspace_company(authorization, x_company_id, db)
    email = str(data.get("email") or "").strip().lower()
    name = str(data.get("name") or "").strip()

    if not email or "@" not in email:
        raise HTTPException(400, "Enter a valid agent email address.")

    member = db.query(OrganizationMember).filter(
        OrganizationMember.organization_id == company["id"],
        OrganizationMember.email == email,
        OrganizationMember.role == "support_agent",
    ).first()

    if member:
        raise HTTPException(409, "This agent email is already registered.")

    member = OrganizationMember(
        organization_id=company["id"],
        email=email,
        full_name=name or None,
        role="support_agent",
        status="approved",
    )
    db.add(member)
    db.commit()
    db.refresh(member)

    return {"message": "Agent registered successfully.", "member_id": member.id, "email": email}


@router.post("/agents/login")
def support_agent_login(data: dict, db: Session = Depends(get_db)):
    email = str(data.get("email") or "").strip().lower()
    if not email or "@" not in email:
        raise HTTPException(400, "Enter a valid registered email.")

    member = db.query(OrganizationMember).filter(
        OrganizationMember.email == email,
        OrganizationMember.role == "support_agent",
        OrganizationMember.status == "approved",
    ).first()

    if not member:
        raise HTTPException(401, "This email is not registered as a support agent.")

    return {
        "message": "Agent email recognized.",
        "member_id": member.id,
        "company_id": member.organization_id,
        "name": member.full_name,
        "email": member.email,
    }



@router.post("/agents/tickets")
def get_agent_tickets(data: dict, db: Session = Depends(get_db)):
    email = str(data.get("email") or "").strip().lower()

    member = db.query(OrganizationMember).filter(
        OrganizationMember.email == email,
        OrganizationMember.role == "support_agent",
        OrganizationMember.status == "approved",
    ).first()

    if not member:
        raise HTTPException(401, "Agent is not registered.")

    tickets = (
        db.query(Ticket)
        .filter(Ticket.company_id == member.organization_id)
        .order_by(Ticket.created_at.desc())
        .all()
    )

    return [
        {column.name: getattr(ticket, column.name)
         for column in Ticket.__table__.columns}
        for ticket in tickets
    ]


@router.get("/agents")
def get_company_agents(
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias="X-Company-ID"),
):
    company = get_workspace_company(authorization, x_company_id, db)

    members = (
        db.query(OrganizationMember)
        .filter(
            OrganizationMember.organization_id == company["id"],
            OrganizationMember.role == "support_agent",
        )
        .order_by(OrganizationMember.created_at.desc())
        .all()
    )

    return [
        {
            "id": member.id,
            "name": member.full_name,
            "email": member.email,
            "role": member.role,
            "status": member.status,
            "email_verified": member.email_verified_at is not None,
            "email_verified_at": member.email_verified_at,
            "approved": member.approved_at is not None,
            "approved_at": member.approved_at,
        }
        for member in members
    ]


@router.get("/{ticket_id}")
def get_ticket(
    ticket_id: str,
    chatbot_id: int,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias="X-Company-ID")
):

    company = get_workspace_company(authorization, x_company_id, db)
    ticket = get_scoped_ticket(db, ticket_id, chatbot_id)

    if ticket and ticket.company_id != company['id']:
        raise HTTPException(404, 'Ticket not found.')

    if not ticket:
        raise HTTPException(
            status_code=404,
            detail="Ticket not found.",
        )

    return ticket




@router.patch("/{ticket_id}")
def update_ticket(
    ticket_id: str,
    data: dict,
    chatbot_id: int,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias="X-Company-ID")
):
    from services.smtp_credentials import send_company_ticket_reply

    company = get_workspace_company(authorization, x_company_id, db)
    ticket = get_scoped_ticket(db, ticket_id, chatbot_id)

    if not ticket or ticket.company_id != company["id"]:
        raise HTTPException(
            status_code=404,
            detail="Ticket not found."
        )

    if "status" in data:
        allowed_statuses = [
            "Open",
            "In Progress",
            "Resolved",
            "Closed",
        ]

        if data["status"] not in allowed_statuses:
            raise HTTPException(400, "Invalid ticket status.")

        ticket.status = data["status"]

    email_sent = None
    email_message = "No email was sent."

    if "agent_reply" in data:
        agent_reply = str(data["agent_reply"]).strip()

        if not agent_reply:
            raise HTTPException(400, "Agent reply cannot be empty.")

        ticket.agent_reply = agent_reply

        db.commit()
        db.refresh(ticket)

        organization_settings = db.query(OrganizationSettings).filter(
            OrganizationSettings.organization_id == ticket.company_id
        ).first()

        if (
            not organization_settings
            or not organization_settings.support_email_verified
        ):
            email_sent = False
            email_message = "Company support email is not verified."

        else:
            company_settings = organization_settings.settings or {}
            smtp_config = company_settings.get("smtp", {})

            if not smtp_config.get("password_encrypted"):
                email_sent = False
                email_message = "Company SMTP is not configured."

            else:
                email_sent, email_message = send_company_ticket_reply(
                    config=smtp_config,
                    support_email=organization_settings.support_email,
                    customer_email=ticket.customer_email,
                    ticket_id=ticket.ticket_id,
                    customer_message=ticket.customer_message,
                    agent_reply=agent_reply,
                )

    else:
        db.commit()
        db.refresh(ticket)

    return {
        "message": "Ticket updated successfully.",
        "ticket_id": ticket.ticket_id,
        "status": ticket.status,
        "agent_reply": ticket.agent_reply,
        "email_sent": email_sent,
        "email_message": email_message,
    }


@router.post("/{ticket_id}/resolution-review")
def review_ticket_resolution(
    ticket_id: str,
    data: dict,
    chatbot_id: int,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias='X-Company-ID')
):

    company = get_workspace_company(authorization, x_company_id, db)
    ticket = get_scoped_ticket(db, ticket_id, chatbot_id)

    if ticket and ticket.company_id != company['id']:
        raise HTTPException(404, 'Ticket not found.')

    if not ticket:
        raise HTTPException(
            status_code=404,
            detail="Ticket not found.",
        )

    if ticket.status not in ["Resolved", "Closed"]:
        raise HTTPException(
            status_code=400,
            detail="Only resolved or closed tickets can be reviewed.",
        )

    if not ticket.agent_reply or not ticket.agent_reply.strip():
        raise HTTPException(
            status_code=400,
            detail="The ticket must have an agent reply before review.",
        )

    decision = str(
        data.get("decision", "")
    ).strip().lower()

    if decision not in ["yes", "no"]:
        raise HTTPException(
            status_code=400,
            detail="Decision must be yes or no.",
        )

    reusable_solution = str(
        data.get("approved_solution", "")
    ).strip()

    if decision == "yes" and not reusable_solution:
        raise HTTPException(
            status_code=400,
            detail="Please provide a reusable solution before approving.",
        )

    review = db.query(TicketResolutionReview).filter(
        TicketResolutionReview.ticket_id == ticket.ticket_id
    ).first()

    if not review:
        review = TicketResolutionReview(
            ticket_id=ticket.ticket_id,
            company_id=ticket.company_id,
            chatbot_id=ticket.chatbot_id,
            complaint=ticket.customer_message,
            intent=ticket.intent,
        )

        db.add(review)

    review.company_id = ticket.company_id
    review.chatbot_id = ticket.chatbot_id
    review.complaint = ticket.customer_message
    review.intent = ticket.intent

    review.approval_status = (
        "approved" if decision == "yes" else "rejected"
    )

    review.approved_solution = (
        reusable_solution if decision == "yes" else ""
    )

    review.approved_at = (
        datetime.now(timezone.utc)
        if decision == "yes"
        else None
    )

    db.commit()
    db.refresh(review)

    return {
        "message": (
            "Solution approved for chatbot use."
            if decision == "yes"
            else "Solution rejected and excluded from chatbot knowledge."
        ),
        "ticket_id": ticket.ticket_id,
        "approval_status": review.approval_status,
        "approved_solution": review.approved_solution,
    }


@router.get("/{ticket_id}/resolution-review")
def get_ticket_resolution_review(
    ticket_id: str,
    chatbot_id: int,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias='X-Company-ID')
):

    company = get_workspace_company(authorization, x_company_id, db)
    ticket = get_scoped_ticket(db, ticket_id, chatbot_id)

    if ticket and ticket.company_id != company['id']:
        raise HTTPException(404, 'Ticket not found.')

    if not ticket:
        raise HTTPException(
            status_code=404,
            detail="Ticket not found.",
        )

    review = (
        db.query(TicketResolutionReview)
        .filter(
            TicketResolutionReview.ticket_id == ticket.ticket_id,
            TicketResolutionReview.company_id == ticket.company_id,
            TicketResolutionReview.chatbot_id == ticket.chatbot_id,
        )
        .first()
    )

    if not review:
        return {
            "ticket_id": ticket.ticket_id,
            "approval_status": None,
            "approved_solution": "",
        }

    return {
        "ticket_id": ticket.ticket_id,
        "approval_status": review.approval_status,
        "approved_solution": review.approved_solution,
    }


@router.post("/{ticket_id}/summarize")
def summarize_ticket(
    ticket_id: str,
    data: dict,
    chatbot_id: int,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias='X-Company-ID')
):

    company = get_workspace_company(authorization, x_company_id, db)
    ticket = get_scoped_ticket(db, ticket_id, chatbot_id)

    if ticket and ticket.company_id != company['id']:
        raise HTTPException(404, 'Ticket not found.')

    if not ticket:
        raise HTTPException(
            status_code=404,
            detail="Ticket not found.",
        )

    mode = str(data.get("mode", "")).strip().lower()

    if mode not in ["normal", "fields"]:
        raise HTTPException(
            status_code=400,
            detail="Mode must be normal or fields.",
        )

    ticket_context = f"""
Customer complaint:
{ticket.customer_message or ""}

Additional customer information:
{ticket.additional_details or ""}

Customer email:
{ticket.customer_email or ""}

Ticket category:
{ticket.intent or ""}

Agent response:
{ticket.agent_reply or ""}
"""

    if mode == "normal":

        prompt = f"""
You are an AI assistant helping a human support agent
understand customer support tickets.

Summarize the following ticket into one concise paragraph.

Rules:
- Clearly explain the customer's main problem.
- Include relevant details.
- Include troubleshooting already attempted if available.
- Include the customer's expected outcome if available.
- Do not invent information.
- Do not repeat irrelevant information.
- Do not use headings or bullet points.
- Return only the summary paragraph.

TICKET:
{ticket_context}
"""

    else:

        prompt = f"""
You are an AI assistant helping a human support agent
understand customer support tickets.

Extract the relevant information into structured fields.

Possible fields:
- Issue
- Product or Service
- Error Message
- Steps Already Tried
- Expected Outcome
- Actual Outcome
- Customer Requirements
- Relevant Technical Details
- Impact

Rules:
- Extract only information explicitly available in the ticket.
- Never invent or assume information.
- Include only fields that contain actual information.
- Omit missing fields completely.
- Never write "Not provided", "Unknown", or "N/A".
- Keep field values concise and informative.
- Return valid JSON only.
- Return a JSON object, not an array.
- Do not include Markdown code fences.

TICKET:
{ticket_context}

Return the JSON object.
"""

    try:

        response = llm.invoke(prompt)
        content = response.content

        if isinstance(content, list):
            content = "".join(
                item.get("text", "")
                for item in content
                if isinstance(item, dict)
            )

        content = str(content).strip()

        if mode == "normal":
            return {
                "ticket_id": ticket.ticket_id,
                "mode": "normal",
                "summary": content,
            }

        if content.startswith("```"):
            content = content.replace("```json", "")
            content = content.replace("```", "")
            content = content.strip()

        extracted_fields = json.loads(content)

        if not isinstance(extracted_fields, dict):
            raise ValueError(
                "AI response must be a JSON object."
            )

        extracted_fields = {
            key: value
            for key, value in extracted_fields.items()
            if value is not None
            and str(value).strip()
            and str(value).strip().lower() not in [
                "not provided",
                "unknown",
                "n/a",
                "none",
                "null",
            ]
        }

        return {
            "ticket_id": ticket.ticket_id,
            "mode": "fields",
            "fields": extracted_fields,
        }

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Ticket summarization failed: {str(exc)}",
        )


@router.get("/{ticket_id}/similar")
def get_similar_tickets(
    ticket_id: str,
    chatbot_id: int,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias='X-Company-ID')
):
    """Find similar tickets belonging to the same chatbot."""

    company = get_workspace_company(authorization, x_company_id, db)
    ticket = get_scoped_ticket(db, ticket_id, chatbot_id)

    if ticket and ticket.company_id != company['id']:
        raise HTTPException(404, 'Ticket not found.')

    if not ticket:
        raise HTTPException(
            status_code=404,
            detail="Ticket not found.",
        )

    result = find_similar_tickets(
        db=db,
        ticket_id=ticket_id,
    )

    if result is None:
        raise HTTPException(
            status_code=404,
            detail="Ticket not found.",
        )

    return result


@router.delete("/agents/{agent_id}")
def revoke_support_agent(
    agent_id: int,
    db: Session = Depends(get_db),
    authorization: str = Header(default=None),
    x_company_id: int = Header(default=None, alias="X-Company-ID"),
):
    company = get_workspace_company(authorization, x_company_id, db)
    actor_id = get_deletion_actor(authorization)

    member = db.query(OrganizationMember).filter(
        OrganizationMember.id == agent_id,
        OrganizationMember.organization_id == company["id"],
        OrganizationMember.role == "support_agent",
    ).first()

    if not member:
        raise HTTPException(404, "Support agent not found.")

    record_deletion(
        db, "support_agent", member.id, member.email,
        company["id"], actor_id, "revoked"
    )
    member.status = "revoked"
    db.commit()
    return {"success": True, "message": "Support agent access revoked."}
